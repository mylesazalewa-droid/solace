{
  "name": "solace",
  "version": "0.3.2",
  "description": "Solace \u2014 a calm notes app: a shelf of notebooks that file and find themselves.",
  "main": "./out/main/index.js",
  "author": "Myles",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "build": {
    "appId": "app.solace.notes",
    "productName": "Solace",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "Solace-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Solace ${version}"
    }
  },
  "dependencies": {
    "@types/turndown": "^5.0.6",
    "firebase": "^12.19.0",
    "gray-matter": "^4.0.3",
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.12.2",
    "marked": "^12.0.2",
    "pdf-parse": "^1.1.1",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@uiw/react-codemirror": "^4.23.5",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "zustand": "^4.5.4"
  }
}